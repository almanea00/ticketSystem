# Ticket Assistant configuration. Copy to .env and edit; environment variables override this file.
# Full list and defaults: ticketassist/config.py

# ---- decision model: a link (Hugging Face id or local folder) run here, or the same model behind a vLLM server ----
TA_DECISION=local
TA_DECISION_MODEL=runs/d1_merged_all   # our fine-tuned d1; LiquidAI/d1-3B = the original
TA_DEVICE=cuda:0
# TA_DECISION=api
# TA_DECISION_API_BASE=http://127.0.0.1:18031/v1
# TA_DECISION_API_KEY=
# TA_DECISION_API_MODEL=d1-ticket
# or a hosted decision API in the same format, e.g. TypeSafe's Jev (zero-shot, not our fine-tuned model):
# TA_DECISION=systemone
# TA_DECISION_API_BASE=https://api.typesafe.ai/v1
# TA_DECISION_API_KEY=...
# TA_DECISION_API_MODEL=jev-latest

# ---- embedder: a Hugging Face sentence-transformers id, or "api" ----
TA_EMBEDDER=google/embeddinggemma-2
# TA_EMBEDDER=api
# TA_EMBED_API_BASE=https://api.openai.com/v1
# TA_EMBED_API_KEY=sk-...
# TA_EMBED_API_MODEL=text-embedding-3-small

# ---- reply writer: "local" (Hugging Face chat model) or "api" (any OpenAI-compatible endpoint) ----
TA_LLM=local
TA_LLM_MODEL=ALLaM-AI/ALLaM-7B-Instruct-preview
TA_LLM_DEVICE=cuda:1
TA_LLM_4BIT=1
# TA_LLM=api
# TA_LLM_API_BASE=https://api.openai.com/v1      # OpenAI
# TA_LLM_API_BASE=https://api.groq.com/openai/v1 # Groq
# TA_LLM_API_BASE=https://openrouter.ai/api/v1   # OpenRouter
# TA_LLM_API_BASE=http://localhost:11434/v1      # Ollama on this machine (no key needed)
# TA_LLM_API_KEY=sk-...
# TA_LLM_API_MODEL=gpt-4o-mini

# ---- knowledge base and decision settings ----
TA_KB_DIR=data/course/kb
TA_TOP_K=4
TA_GUARD_BLOCK=0.2
TA_GUARD_SUPPORT=0.05
TA_ANSWER_MIN=0.3

# gated Hugging Face models (if any) read HF_TOKEN
# HF_TOKEN=hf_...

# Serving the decision model with vLLM (any d1-style folder or Hugging Face id):
#   vllm serve runs/d1_merged_all --served-model-name d1-ticket --logprobs-mode processed_logprobs \
#     --max-logprobs 400 --no-enable-prefix-caching --limit-mm-per-prompt '{"image":0}'
